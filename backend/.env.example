# ==============================================================================
# TULSI MART ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to backend/.env and configure your secrets
# ==============================================================================

PROJECT_NAME="Tulsi Mart API"
ENVIRONMENT=production
API_V1_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# Security & JWT Tokens
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_256_bit_random_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=168
JWT_ISSUER=tulsi-mart-api
JWT_AUDIENCE=tulsi-mart-client

# Login Brute-Force & Rate Limiting Protection (Max 3 wrong attempts, 15 min lockout)
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_LOCKOUT_SECONDS=900
GLOBAL_RATE_LIMIT_PER_MINUTE=100

# Database Configuration (MySQL, PostgreSQL, or SQLite)
# Production MySQL:
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl_mode=REQUIRED
MYSQL_URL=
DB_NAME=defaultdb
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=18925
DB_SSL_MODE=REQUIRED

# Redis In-Memory Cache (Upstash, Aiven, or Local Redis)
REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=3600

# CORS Allowed Origins (Comma-separated production & client domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-production-app.vercel.app

# Production Safety Settings (Set to true only for dev testing)
SEED_DEMO_DATA=false
