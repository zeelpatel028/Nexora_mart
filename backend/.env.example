# NMART Backend Configuration
PROJECT_NAME="NMART API"
ENVIRONMENT=development
API_V1_PREFIX=/api

# Security & Tokens
SECRET_KEY=*****
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite, MySQL, or PostgreSQL)
DATABASE_URL=sqlite:///./nmart.db
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl_mode=REQUIRED
MYSQL_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSL_MODE=

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Redis In-Memory Cache (User sessions, Profile cache, Token blacklist)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=3600
