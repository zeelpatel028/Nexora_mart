# NMART Backend Configuration Template
PROJECT_NAME="NMART API"
ENVIRONMENT=production
API_V1_PREFIX=/api

# Security & Secret Key (Generate on Render or use a strong random secret)
SECRET_KEY=change_me_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Render PostgreSQL, MySQL, or SQLite)
# For Render PostgreSQL: Render provides DATABASE_URL automatically
DATABASE_URL=sqlite:///./nmart.db
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://*.onrender.com,http://localhost:5173,http://localhost:3000

# Redis In-Memory Cache (Set false if not using Redis)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

